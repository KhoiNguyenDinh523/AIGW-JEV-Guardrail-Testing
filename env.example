# Copy file này thành .env rồi điền khóa. KHÔNG commit .env lên git.

# ---- OpenRouter (dịch, judge, và/hoặc model đích) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE=https://openrouter.ai/api/v1

# ---- 9router (AI Gateway chạy local) ----
ROUTER9_BASE=http://localhost:20128/v1
ROUTER9_API_KEY=...

# ---- Hugging Face (WildGuardMix) ----
# HF_TOKEN=...

# ---- Các model dùng trong pipeline ----
# Nguồn gọi API riêng cho dịch xuôi (step2) & dịch ngược (step3): 9router | openrouter
# Khi dùng 9router: lấy đúng tên model từ GET http://localhost:20128/v1/models (ví dụ ag/gemini-2.5-flash)
TRANSLATE_VIA=9router
TRANSLATE_MODEL=ag/gemini-3.8-flash-low(low)
BACKTRANS_VIA=9router
BACKTRANS_MODEL=gemini-2.5-pro
JUDGE_MODEL=openai/gpt-4o-mini
EMB_MODEL=sentence-transformers/LaBSE
EMB_THRESHOLD=0.82

# Model đích (Target LLM). TARGET_VIA = openrouter | 9router
# Nếu 9router: dùng đúng tên model theo dạng provider-prefix/model-id mà /v1/models của 9router trả về.
TARGET_VIA=openrouter
TARGET_MODEL=openai/gpt-4o-mini
TARGET_MAX_TOKENS=512

# ---- Ollama (Hướng 2 và JEV nếu chạy dạng SLM) ----
OLLAMA_BASE=http://localhost:11434
H2_BACKEND=llamaguard          # llamaguard | judge
H2_MODEL=llama-guard3:8b
# ---- JEV (Hướng 3) ----
JEV_BACKEND=mock               # hf | onnx | ollama | mock   (mock chỉ để chạy thử pipeline)
JEV_MODEL=./models/jev         # đường dẫn thư mục model (hf/onnx) hoặc tên model Ollama
JEV_TAU=0.55

# ---- Proxy ----
GUARD=h3                       # h2 | h3
GUARD_SCOPE=last               # last = chỉ user message cuối | all = gộp mọi user message
GUARD_FAIL_MODE=closed         # closed = lỗi guard thì chặn | open = lỗi guard thì cho qua
LOG_PREVIEW_CHARS=0            # 0 = KHÔNG lưu nội dung prompt vào audit log (chỉ lưu hash)
